# BACKEND ONLY. Never prefix any credential with VITE_. Do not commit a real value.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
CLASSROOM_ACCESS_CODE=
# Local development origins. Public deployment: replace with the Pages ORIGIN
# https://raycao1122-droid.github.io (no repository path).
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Local default 127.0.0.1; hosted service needs 0.0.0.0.
CLASSROOM_HOST=127.0.0.1
CLASSROOM_API_PORT=8787
# Optional existing M3 text feature. Does NOT enable OpenAI realtime voice.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Public backend URL only; safe to bundle. This is NOT a credential.
# VITE_CLASSROOM_API_URL=https://your-backend.onrender.com
